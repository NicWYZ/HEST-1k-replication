{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Round-3 task definition, version 1, D4 expansion extension (round3_execution_plan.md section 13.7)",
 "type": "object",
 "required": [
  "expansion",
  "flags",
  "folds",
  "label_set",
  "paths",
  "provenance",
  "repo_root_relative",
  "samples",
  "source",
  "st_technology",
  "target_genes",
  "task",
  "task_def_version"
 ],
 "additionalProperties": false,
 "properties": {
  "task_def_version": {
   "const": 1
  },
  "task": {
   "type": "string",
   "minLength": 1
  },
  "label_set": {
   "enum": [
    "shipped",
    "audited"
   ]
  },
  "source": {
   "enum": [
    "hest_bench",
    "hest_ext"
   ]
  },
  "st_technology": {
   "type": "string"
  },
  "repo_root_relative": {
   "const": true
  },
  "paths": {
   "type": "object",
   "required": [
    "adata",
    "patches",
    "embeddings",
    "target_genes"
   ],
   "additionalProperties": false,
   "properties": {
    "adata": {
     "type": "string"
    },
    "patches": {
     "type": "string"
    },
    "embeddings": {
     "type": "string"
    },
    "target_genes": {
     "type": "string"
    }
   }
  },
  "target_genes": {
   "type": "object",
   "required": [
    "list",
    "n",
    "selection",
    "selection_used_test_spots"
   ],
   "additionalProperties": false,
   "properties": {
    "list": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "n": {
     "type": "integer",
     "minimum": 1
    },
    "selection": {
     "type": "string",
     "minLength": 1
    },
    "selection_used_test_spots": {
     "type": "boolean"
    }
   }
  },
  "samples": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "donor_id",
     "donor_label_status",
     "donor_label_status_row_origin",
     "excluded_from_donor_units",
     "hest_patient",
     "instrument_generation",
     "lab",
     "lab_label_status",
     "n_expr_spots",
     "n_patch_spots",
     "n_spots",
     "pixel_size_um",
     "population",
     "preservation",
     "region",
     "resolution_group",
     "resolution_uncertain",
     "sample_id",
     "session",
     "source",
     "unpatched_fraction"
    ],
    "additionalProperties": false,
    "properties": {
     "sample_id": {
      "type": "string"
     },
     "donor_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "hest_patient": {
      "type": [
       "string",
       "null"
      ]
     },
     "donor_label_status": {
      "enum": [
       "verified",
       "unverifiable",
       "contradicted"
      ]
     },
     "lab": {
      "type": "string"
     },
     "lab_label_status": {
      "enum": [
       "unverified",
       "verified",
       "contradicted"
      ]
     },
     "session": {
      "type": [
       "string",
       "null"
      ]
     },
     "resolution_group": {
      "type": "string"
     },
     "pixel_size_um": {
      "type": "number"
     },
     "resolution_uncertain": {
      "type": "boolean"
     },
     "n_spots": {
      "type": "integer",
      "minimum": 1
     },
     "source": {
      "type": "string"
     },
     "population": {
      "type": "string"
     },
     "instrument_generation": {
      "type": "string"
     },
     "preservation": {
      "type": "string"
     },
     "region": {
      "type": "string"
     },
     "disease": {
      "type": "string"
     },
     "disease_group": {
      "type": "string"
     },
     "donor_label_status_row_origin": {
      "enum": [
       "benchmark_r2",
       "expansion_d3"
      ]
     },
     "donor_label_status_other_origin": {
      "type": [
       "string",
       "null"
      ]
     },
     "donor_id_other_origin": {
      "type": [
       "string",
       "null"
      ]
     },
     "resolution_uncertain_rederived": {
      "type": "string"
     },
     "pixel_size_um_embedded": {
      "type": [
       "number",
       "null"
      ]
     },
     "magnification_hest": {
      "type": "string"
     },
     "scanner": {
      "type": "string"
     },
     "n_expr_spots": {
      "type": "integer",
      "minimum": 1
     },
     "n_patch_spots": {
      "type": "integer",
      "minimum": 1
     },
     "unpatched_fraction": {
      "type": "number",
      "minimum": 0
     },
     "excluded_from_donor_units": {
      "type": "boolean"
     },
     "in_benchmark": {
      "type": "boolean"
     },
     "hest_dataset_title": {
      "type": "string"
     }
    }
   }
  },
  "flags": {
   "type": "object",
   "required": [
    "patient_labels_unreliable",
    "same_specimen_pairs",
    "idc_attribution_unresolved"
   ],
   "additionalProperties": false,
   "properties": {
    "patient_labels_unreliable": {
     "type": "boolean"
    },
    "same_specimen_pairs": {
     "type": "boolean"
    },
    "idc_attribution_unresolved": {
     "type": "boolean"
    }
   }
  },
  "folds": {
   "type": "object",
   "required": [
    "patient",
    "donor",
    "slide_out",
    "random"
   ],
   "additionalProperties": false,
   "properties": {
    "patient": {
     "$ref": "#/definitions/foldList"
    },
    "donor": {
     "$ref": "#/definitions/foldList"
    },
    "slide_out": {
     "$ref": "#/definitions/foldList"
    },
    "random": {
     "type": "object",
     "required": [
      "n_repeats",
      "test_size_from_fold",
      "seed_source"
     ],
     "additionalProperties": false,
     "properties": {
      "n_repeats": {
       "type": "integer",
       "minimum": 1
      },
      "test_size_from_fold": {
       "type": "string"
      },
      "seed_source": {
       "const": "crc32"
      }
     }
    },
    "population_out": {
     "$ref": "#/definitions/foldList"
    }
   }
  },
  "provenance": {
   "type": "object",
   "required": [
    "generated_by",
    "generated_at",
    "commit",
    "inputs",
    "pythonhashseed"
   ],
   "additionalProperties": false,
   "properties": {
    "generated_by": {
     "type": "string"
    },
    "generated_at": {
     "type": "string"
    },
    "commit": {
     "type": "string"
    },
    "inputs": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "pythonhashseed": {
     "type": [
      "string",
      "null"
     ]
    },
    "script_md5": {
     "type": "string"
    }
   }
  },
  "expansion": {
   "type": "object"
  }
 },
 "definitions": {
  "foldList": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "fold",
     "train",
     "test"
    ],
    "additionalProperties": false,
    "properties": {
     "fold": {
      "type": "string"
     },
     "train": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     },
     "test": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     }
    }
   }
  }
 }
}
