{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Round-3 task definition, version 1",
  "type": "object",
  "required": ["task_def_version", "task", "label_set", "source", "st_technology",
               "repo_root_relative", "paths", "target_genes", "samples", "flags",
               "folds", "provenance"],
  "additionalProperties": false,
  "properties": {
    "task_def_version": {"const": 1},
    "task": {"type": "string", "minLength": 1},
    "label_set": {"enum": ["shipped", "audited"]},
    "source": {"enum": ["hest_bench", "hest_ext"]},
    "st_technology": {"type": "string"},
    "repo_root_relative": {"const": true},
    "paths": {
      "type": "object",
      "required": ["adata", "patches", "embeddings", "target_genes"],
      "additionalProperties": false,
      "properties": {
        "adata": {"type": "string"},
        "patches": {"type": "string"},
        "embeddings": {"type": "string"},
        "target_genes": {"type": "string"}
      }
    },
    "target_genes": {
      "type": "object",
      "required": ["list", "n", "selection", "selection_used_test_spots"],
      "additionalProperties": false,
      "properties": {
        "list": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "n": {"type": "integer", "minimum": 1},
        "selection": {"type": "string", "minLength": 1},
        "selection_used_test_spots": {"type": "boolean"}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sample_id", "donor_id", "hest_patient", "donor_label_status", "lab",
                     "lab_label_status", "session", "resolution_group", "pixel_size_um",
                     "resolution_uncertain", "n_spots"],
        "additionalProperties": false,
        "properties": {
          "sample_id": {"type": "string"},
          "donor_id": {"type": ["string", "null"]},
          "hest_patient": {"type": ["string", "null"]},
          "donor_label_status": {"enum": ["verified", "unverifiable", "contradicted"]},
          "lab": {"type": "string"},
          "lab_label_status": {"enum": ["unverified", "verified", "contradicted"]},
          "session": {"type": ["string", "null"]},
          "resolution_group": {"type": "string"},
          "pixel_size_um": {"type": "number"},
          "resolution_uncertain": {"type": "boolean"},
          "n_spots": {"type": "integer", "minimum": 1}
        }
      }
    },
    "flags": {
      "type": "object",
      "required": ["patient_labels_unreliable", "same_specimen_pairs", "idc_attribution_unresolved"],
      "additionalProperties": false,
      "properties": {
        "patient_labels_unreliable": {"type": "boolean"},
        "same_specimen_pairs": {"type": "boolean"},
        "idc_attribution_unresolved": {"type": "boolean"}
      }
    },
    "folds": {
      "type": "object",
      "required": ["patient", "donor", "slide_out", "random"],
      "additionalProperties": false,
      "properties": {
        "patient": {"$ref": "#/definitions/foldList"},
        "donor": {"$ref": "#/definitions/foldList"},
        "slide_out": {"$ref": "#/definitions/foldList"},
        "random": {
          "type": "object",
          "required": ["n_repeats", "test_size_from_fold", "seed_source"],
          "additionalProperties": false,
          "properties": {
            "n_repeats": {"type": "integer", "minimum": 1},
            "test_size_from_fold": {"type": "string"},
            "seed_source": {"const": "crc32"}
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generated_by", "generated_at", "commit", "inputs", "pythonhashseed"],
      "additionalProperties": false,
      "properties": {
        "generated_by": {"type": "string"},
        "generated_at": {"type": "string"},
        "commit": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "pythonhashseed": {"type": ["string", "null"]}
      }
    }
  },
  "definitions": {
    "foldList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fold", "train", "test"],
        "additionalProperties": false,
        "properties": {
          "fold": {"type": "string"},
          "train": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "test": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    }
  }
}
